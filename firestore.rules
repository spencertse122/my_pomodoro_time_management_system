rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/sessions/{sessionId} {
      // v2 may only read old records and permanently purge them. No client can
      // create or update activity data in Firestore.
      allow read, delete: if owns(userId);
      allow create, update: if false;
    }

    match /users/{userId}/settings/pomodoro {
      allow read, delete: if owns(userId);
      allow create, update: if false;
    }
  }
}
